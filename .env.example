# Copy to .env (gitignored) and fill in. A Battle.net API client from
# https://community.developer.battle.net/access/clients
ZESQUAD_BNET_CLIENT_ID=
ZESQUAD_BNET_CLIENT_SECRET=

# Optional: a password everyone must enter first. Leave empty for an open site.
ZESQUAD_PASSWORD=

# Optional, for `just network-test`: any real Forever character and its region (default eu).
ZESQUAD_TEST_CHARACTER=
ZESQUAD_TEST_REGION=
